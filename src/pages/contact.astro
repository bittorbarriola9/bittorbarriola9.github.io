---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
// 👇 Cambia esta imagen por la tuya.
// 1. Coloca tu archivo en: src/assets/images/contact/<tu-imagen>.(png|jpg|jpeg|webp|svg)
// 2. Actualiza la línea de abajo con la ruta correcta.
import coverImage from "../assets/images/contact/contact-cover.png";
---

<MainLayout activePage="contact" pageTitle={siteConfig.title + " | Contact"}>
  <div class="page-content">
    <h1 class="sigmar-ff text-balance">{siteConfig.contactInfo?.title}</h1>
    <Image
      width={400}
      height={300}
      loading="eager"
      layout="fixed"
      class="rounded-4xl mb-8 mx-auto"
      src={coverImage}
      alt="Contact illustration"
    />
    <div class="flex flex-col gap-4">
      <p class="font-light text-left text-balance whitespace-pre-line">
        {siteConfig.contactInfo?.text}
      </p>
      <p class="font-light text-left">
        {siteConfig.contactInfo?.email?.text}<br />
        <a
          href={siteConfig.contactInfo?.email?.href}
          class="font-light text-left"
        >
          {siteConfig.contactInfo?.email?.email}
        </a>
      </p>
      {siteConfig.contactInfo?.socialNote && (
        <p class="font-light text-left text-balance">
          {siteConfig.contactInfo.socialNote}
        </p>
      )}
      <p class="font-bold text-left flex flex-col sm:flex-row sm:flex-wrap sm:items-center">
        Social Profiles:
        {
          siteConfig.contactInfo?.socialProfiles?.map((profile) => (
            <a href={profile.href} class="font-light text-left ml-0 sm:ml-4" target="_blank">
              {profile.text}
            </a>
          ))
        }
      </p>
    </div>
  </div>
</MainLayout>
