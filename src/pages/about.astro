---

<MainLayout activePage="about" pageTitle={siteConfig.title + " | About me"}>
  <div class="page-content">
    <h1 class="sigmar-ff text-balance">About me</h1>

    <section class="about-intro text-left">
      <p class="kanit-light whitespace-pre-line text-balance text-sm sm:text-base">
        {introPreview}
      </p>

      <div
        id="intro-extended"
        class="intro-extended kanit-light whitespace-pre-line text-balance text-sm sm:text-base"
        hidden
      >
        {introExtended}
      </div>

      <div class="intro-toggle-wrap">
        <button id="intro-toggle" class="intro-toggle-link" type="button" aria-expanded="false">
          <span class="intro-toggle-label">Need more lore? Continue scrolling the saga ☕</span>
          <span class="intro-toggle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </button>
      </div>
    </section>

    <section class="my-10">
      <hr class="border-gray-500/40 mb-5" />
      <div class="skills-showcase">
        <SkillsMarquee items={topSkills} secondsPerItem={skillsSpeedPerItem} />

        <div class="skills-middle-row">
          <SkillsMarquee
            items={middleSkills}
            reverse={true}
            secondsPerItem={skillsSpeedPerItem}
          />
          <span class="skills-center-label sigmar-ff text-lg sm:text-2xl" data-label="Skills">Skills</span>
        </div>

        <SkillsMarquee items={bottomSkills} secondsPerItem={skillsSpeedPerItem} />
      </div>
      <hr class="border-gray-500/40 mt-5" />
    </section>

    <section class="my-10">
      <h2 class="sigmar-ff text-lg sm:text-2xl pt-0! pb-4!">My Journey</h2>
      <AboutTabs client:load sections={cvSections} />
    </section>
  </div>
</MainLayout>

<script is:inline>
  const toggleBtn = document.getElementById("intro-toggle");
  const extended = document.getElementById("intro-extended");
  const toggleLabel = toggleBtn?.querySelector(".intro-toggle-label");

  if (toggleBtn && extended && toggleLabel) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = extended.hasAttribute("hidden");

      if (isHidden) {
        extended.removeAttribute("hidden");
        toggleLabel.textContent = "Okay, enough drama. Show less.";
        toggleBtn.classList.add("is-expanded");
        toggleBtn.setAttribute("aria-expanded", "true");
      } else {
        extended.setAttribute("hidden", "");
        toggleLabel.textContent = "Need more lore? Continue scrolling the saga ☕";
        toggleBtn.classList.remove("is-expanded");
        toggleBtn.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>

<style>
  .about-intro {
    margin-bottom: 1.25rem;
  }

  .about-intro p,
  .intro-extended {
    margin-bottom: 0.9rem;
  }

  .intro-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-top: 0.1rem;
    width: 100%;
  }

  .intro-toggle-link {
    align-items: center;
    background: transparent;
    border: 0;
    color: rgba(20, 20, 20, 0.72);
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 0.3rem;
    letter-spacing: 0.01em;
    line-height: 1.2;
    padding: 0;
    text-align: center;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .intro-toggle-label {
    display: block;
  }

  .intro-toggle-icon {
    display: inline-flex;
    opacity: 0.88;
  }

  .intro-toggle-icon svg {
    animation: intro-chevron-bounce 1.8s ease-in-out infinite;
    display: block;
    height: 1rem;
    transition: transform 0.2s ease;
    width: 1rem;
  }

  .intro-toggle-link.is-expanded .intro-toggle-icon svg {
    animation: none;
    transform: rotate(180deg);
  }

  .intro-toggle-link:hover {
    color: rgba(20, 20, 20, 0.9);
  }

  :global(html.dark) .intro-toggle-link {
    color: rgba(245, 245, 245, 0.76);
  }

  :global(html.dark) .intro-toggle-link:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  @keyframes intro-chevron-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(3px);
    }
    70% {
      transform: translateY(1px);
    }
  }

  .skills-showcase {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skills-middle-row {
    position: relative;
  }

  .skills-center-label {
    color: var(--color-space-yellow);
    display: inline-block;
    isolation: isolate;
    left: 50%;
    letter-spacing: 0.04em;
    line-height: 1;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 6;
    text-shadow:
      0 0 8px rgba(255, 255, 133, 0.35),
      0 0 16px rgba(255, 255, 133, 0.2);
  }

  .skills-center-label::before,
  .skills-center-label::after {
    content: attr(data-label);
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .skills-center-label::before {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 133, 0.55);
    filter: blur(1.8px);
    opacity: 0.95;
    z-index: -1;
  }

  .skills-center-label::after {
    color: rgba(255, 255, 133, 0.35);
    filter: blur(5px);
    opacity: 0.65;
    z-index: -2;
  }

</style>
