---
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import SkillsMarquee from "../components/SkillsMarquee.astro";
import AboutTabs from "../components/AboutTabs.jsx";
import "../styles/about-tabs.css";

const skillImageModules = import.meta.glob(
  "../assets/images/skills/*.{png,jpg,jpeg,webp,avif,svg}",
  { eager: true, import: "default" },
);

const journeyImageModules = import.meta.glob(
  "../assets/images/myjourney/*.{png,jpg,jpeg,webp,avif,svg}",
  { eager: true, import: "default" },
);

const resolveSkillIcon = (fileName: string) => {
  const assetPath = `../assets/images/skills/${fileName}`;
  const loaded = skillImageModules[assetPath] as
    | string
    | { src?: string }
    | undefined;

  if (!loaded) return undefined;
  return typeof loaded === "string" ? loaded : loaded.src;
};

const resolveJourneyIcon = (fileName: string) => {
  const assetPath = `../assets/images/myjourney/${fileName}`;
  const loaded = journeyImageModules[assetPath] as
    | string
    | { src?: string }
    | undefined;

  if (!loaded) return undefined;
  return typeof loaded === "string" ? loaded : loaded.src;
};

const introPreview = `Hi, I'm Bittor - mechanical engineer by diploma, Product Owner by job title, and full-time tech addict by natural instinct. Most people online know me as bittorbarriola9, mostly because apparently using the same username everywhere counts as having a personal brand nowadays.

My work life is basically split into two parallel universes.
One side is the "serious corporate" world: endless Teams meetings, Outlook emails, Jira tickets, PowerPoint presentations, roadmaps, planning sessions, and trying to make complicated things sound simple without starting another meeting about the meeting.`;

const introExtended = `The other side - the fun side - is my technical playground: VSCode open at all times, GitHub repos, Kubernetes clusters, DevOps stuff, dashboards, automations, integrations... the part of my job that sadly gets smaller over time, but the one where I genuinely lose track of time and enjoy myself the most.

Outside work... well, honestly, I'm still kind of working.
I'm one of those people constantly testing new tools, apps, AI platforms, gadgets, workflows & automations, productivity hacks, newsletters, podcasts... or anything remotely capable of making life smarter, easier, or more efficient. Some people relax watching Netflix. I relax reorganizing dashboards, discovering AI tools at 1AM, or buying another gadget I absolutely did not need but somehow fully convinced myself was "useful".

I'm also heavily into AI and emerging tech. At this point, half my YouTube recommendations are probably startups nobody has heard of yet and people explaining why AI agents will replace us all by next Tuesday.

And then there's sport - my second operating system.
futsal, football & padel, principally. I genuinely lost count of how many training sessions and matches I play every week. I currently play in four football teams and three padel teams/leagues, which sounds impressive until you realize it's probably just poor time-management with extra cardio.

Between work, side projects, sports, ideas, podcasts, random investigations, and "quick things" that somehow become three-hour deep dives... sleep is usually the first sacrifice. Not ideal, I know.

And to keep all this running?
Caffeine. A lot of caffeine.
I'm a huge coffee fan, and at this point I'm not completely sure whether my projects are powered by passion, curiosity, or espresso-based survival.

This site is basically my little digital space to share projects, ideas, experiments, tech stuff, random discoveries, and probably a few overly ambitious concepts that sounded easier in my head. If you made it this far, feel free to connect, say hi, or send a virtual coffee - statistically speaking, there's a high chance it gets converted into another side project, automation, or unnecessary self-hosted service.`;

