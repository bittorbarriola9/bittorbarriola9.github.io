---
import Button from "./Button.astro";

type Props = {
  href: string;
  label: string;
  icon: string;
  class?: string;
};

const { href, label, icon, class: className } = Astro.props as Props;
---

<Button
  href={href}
  title={label}
  aria-label={label}
  class:list={[
    "group inline-flex shrink-0 aspect-square w-12 items-center justify-center rounded-full border border-gray-500 bg-transparent !p-0 !px-0 !py-0 text-current transition hover:border-space-red hover:text-space-red dark:hover:border-space-yellow dark:hover:text-space-yellow",
    className,
  ]}
>
  <img
    src={icon}
    alt=""
    aria-hidden="true"
    class="h-9 w-9 object-contain transition group-hover:scale-110"
  />
  <span class="sr-only">{label}</span>
</Button>