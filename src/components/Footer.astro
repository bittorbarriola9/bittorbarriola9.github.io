---
import siteConfig from "../site.config";
import SiteIdentity from "./SiteIdentity.astro";
const currentYear = new Date().getFullYear();
---

<footer class="kanit-light text-xs sm:text-sm">
  <div
    class="footer-secondary flex flex-col items-center justify-center gap-3 min-w-full border-t border-gray-500/50 pt-6 text-center"
  >
    <div class="flex flex-row gap-4 items-center justify-center flex-wrap">
      {
        siteConfig.socialLinks?.map((link) => (
          <a href={link.href} title={link.text} target="_blank">
            {link.text}
          </a>
        ))
      }
    </div>
    <div class="flex flex-row gap-2 items-center justify-center text-balance">
      <span>&copy; {currentYear}</span>
      {siteConfig.title}. All rights reserved.
    </div>
  </div>
  <div
    class="footer-identity h-40 sm:h-18 w-full px-2 text-center overflow-hidden sticky bottom-0 items-end"
  >
    <span
      class="sigmar-ff block w-full text-center whitespace-nowrap text-[clamp(1rem,5vw,5rem)] leading-none text-whitesmoke/50 dark:text-gray-300/30"
      >{siteConfig.title}</span
    >
  </div>
</footer>
